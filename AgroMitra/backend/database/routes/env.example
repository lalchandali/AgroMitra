# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real secrets.

# PostgreSQL connection string, e.g.
# postgresql://user:password@localhost:5432/agromitra
DATABASE_URL=

# Secret used to sign JWT access/refresh tokens. Use a long random string.
JWT_SECRET_KEY=

# Free API key from https://openweathermap.org/api — required for the
# "Weather Intelligence" feature (/api/v1/weather/alert). Without it, that
# endpoint returns HTTP 503 rather than fake data.
OPENWEATHER_API_KEY=
