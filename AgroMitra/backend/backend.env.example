# Copy this file to `.env` in the same folder (backend/) and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Free API key from https://openweathermap.org/api — required for the
# "Weather Intelligence" feature (/api/v1/weather/alert). Without it, that
# endpoint returns HTTP 503 rather than fake data.
OPENWEATHER_API_KEY=

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Defaults to http://localhost:5173,http://127.0.0.1:5173 if not set.
# When deploying, set this to your real frontend URL(s).
ALLOWED_ORIGINS=
