# Copy this file to `.env` in the same folder (backend/) and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────
# postgresql://username:password@host:port/database_name
# If unset, falls back to postgresql://postgres:postgres@localhost:5432/agromitra_db
# (local dev only — see database/database.py). Set this for anything beyond that.
DATABASE_URL=

# Admin credentials for the ONE-TIME `python database/scripts/create_db.py`
# step, which creates the agromitra_db database itself (before any tables
# exist). Usually the same Postgres superuser as in DATABASE_URL above.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Auth ──────────────────────────────────────────────────────
# Signs every JWT (access + refresh tokens). REQUIRED — if left unset, the
# app falls back to a hardcoded dev value that's visible in source control,
# meaning anyone could forge a valid token (including as an admin). Generate
# one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# development | production — production stops OTP codes from being echoed
# back in the /request-otp and /forgot-password API responses (dev-only
# convenience, since there's no real SMS gateway). Set this before any demo
# or deployment anyone outside your team can reach.
ENVIRONMENT=development

# ── External API ──────────────────────────────────────────────
# Free API key from https://openweathermap.org/api — required for the
# "Weather Intelligence" feature (/api/v1/weather/alert). Without it, that
# endpoint returns HTTP 503 rather than fake data.
OPENWEATHER_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API (CORS).
# Defaults to http://localhost:5173,http://127.0.0.1:5173 if not set.
# When deploying, set this to your real frontend URL(s).
ALLOWED_ORIGINS=
